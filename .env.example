# Firebase Cloud Function endpoint that receives visit beacons.
# After `firebase deploy --only functions`, copy the printed trackVisit URL here.
#
# NOTE: Vite inlines VITE_* vars at BUILD time. For production you must also set
# this same variable in Netlify (Site settings -> Environment variables), or the
# built site won't have an endpoint and tracking silently no-ops.
VITE_TRACKING_ENDPOINT=https://us-central1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net/trackVisit
